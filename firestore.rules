rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private profile: only the owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public leaderboard: any signed-in user reads; only the owner writes
    // their own entry, with bounded fields.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'totalPoints', 'totalStudyMinutes',
              'currentStreak', 'longestStreak'])
        && request.resource.data.totalPoints is int
        && request.resource.data.totalPoints >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
