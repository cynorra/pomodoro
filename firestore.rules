rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private profile: only the owner.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // A field is either absent or an int within [0, max]. Writes are merged
    // piecemeal (points/minutes and streaks are synced separately), so every
    // field has to be optional.
    function boundedInt(d, field, max) {
      return !(field in d)
        || (d[field] is int && d[field] >= 0 && d[field] <= max);
    }

    // Public leaderboard: any signed-in user reads; only the owner writes
    // their own entry, with typed and bounded fields. The score is still
    // client-asserted, so the caps only limit how far it can be inflated;
    // a trusted score needs a server-side writer (Cloud Function).
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['displayName', 'totalPoints', 'totalStudyMinutes',
              'currentStreak', 'longestStreak'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40))
        && boundedInt(request.resource.data, 'totalPoints', 10000000)
        && boundedInt(request.resource.data, 'totalStudyMinutes', 1000000)
        && boundedInt(request.resource.data, 'currentStreak', 100000)
        && boundedInt(request.resource.data, 'longestStreak', 100000);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Player reports: write-only for signed-in users, one per reporter and
    // player (the document id encodes both), never readable from the app.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['reportedUid', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['reportedUid', 'reporterUid', 'reason', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid.size() <= 128
        && reportId == request.auth.uid + '_' + request.resource.data.reportedUid
        && request.resource.data.reason in ['inappropriateName', 'cheating', 'other']
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
